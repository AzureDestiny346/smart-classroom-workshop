# ===========================================
# 智课工坊 - 环境变量配置示例
# ===========================================

# 复制此文件为 .env.local 并填写实际值

# 应用URL（用于生成链接）
NEXT_PUBLIC_APP_URL=http://localhost:5000

# 端口配置
PORT=5000
NODE_ENV=development

# 关闭遥测
NEXT_TELEMETRY_DISABLED=1

# ===========================================
# AI 大模型配置（coze-coding-dev-sdk）
# ===========================================
# 不配置时 SDK 走默认端点（api.openai.com，国内网络不可达且受地区限制）
# 推荐使用 OpenAI 兼容端点（如阿里云百炼 DashScope，国内直连）：

# API Key（注意：值不要加引号，URL 不要重复 https: 前缀）
COZE_WORKLOAD_IDENTITY_API_KEY=sk-xxxxxxxx

# OpenAI 兼容端点（以 /v1 结尾）
COZE_INTEGRATION_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名（必须与端点配套：DashScope 用 qwen 系列，缺省为 SDK 默认豆包模型会 404）
LLM_MODEL=qwen-plus

# ===========================================
# 生产环境变量（在 Vercel/Docker 中配置）
# ===========================================

# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
